{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:51236",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "ConnectionStrings": {
    "FileXferDb": "",
    "BudiDev": ""
  },
  "Security": {
    "SeedAdmins": [],
    "Jwt": {
      "Issuer": "FileXferIssuer",
      "Audience": "FileXferClients",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "PathEncryptionKey": "",
    "LegacyPathEncryptionKey": "",
    "Receipts": {
      "PrivateKeyPem": "",
      "PrivateKeyPemPath": "",
      "PrivateKeyPassword": "",
      "AllowEphemeralDevelopmentKey": true
    },
    "SAT": {
      "AllowDevelopmentBypass": false,
      "RequireOcsp": true,
      "AcceptClockSkewMinutes": 10,
      "FailOnUnknownRevocation": true,
      "OnlineTimeoutMs": 4000,
      "TrustedRootCertificatePaths": [],
      "IntermediateCertificatePaths": [],
      "AllowedRevocationHosts": []
    },
    "AuthRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "LockoutThreshold": 5,
      "LockoutMinutes": 30
    },
    "DevicePolicy": {
      "RotationDays": 180,
      "MinRsaBits": 2048,
      "BlockLoginWhenExpired": false
    }
  },
  "Alerts": {
    "Enabled": false,
    "SmtpTimeoutSeconds": 15,
    "WebhookTimeoutSeconds": 10
  },
  "DebugFeatures": {
    "EnableDebugUploadEndpoints": false,
    "AllowedEnvironments": [
      "Development"
    ],
    "AllowedRoles": [
      "admin",
      "ops"
    ]
  },
  "Storage": {
    "BasePath": "",
    "MaxUploadBytes": 1073741824,
    "MaxChunkBytes": 2097152,
    "MaxConcurrentUploadsTotal": 200,
    "MaxConcurrentUploadsPerRfc": 5,
    "FirstChunkTimeoutSeconds": 30,
    "IdleChunkTimeoutSeconds": 120,
    "MaxUploadDurationMinutes": 60,
    "ResumeRetentionHours": 24
  },
  "ClientUpdates": {
    "Clients": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

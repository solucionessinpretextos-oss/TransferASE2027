{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:51136",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "ConnectionStrings": {
    "FileXferDb": "Server=(localdb)\\MSSQLLocalDB;Database=FileXferDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Security": {
    "SeedAdmins": [],
    "SAT": {
      "AllowDevelopmentBypass": false,
      "FailOnUnknownRevocation": true
    }
  },
  "Alerts": {
    "Enabled": false
  },
  "DebugFeatures": {
    "EnableDebugUploadEndpoints": false
  },
  "Storage": {
    "BasePath": "C:\\Tmp\\Transfer\\uploads",
    "MaxUploadBytes": 1073741824,
    "MaxChunkBytes": 2097152,
    "MaxConcurrentUploadsTotal": 50,
    "MaxConcurrentUploadsPerRfc": 5,
    "FirstChunkTimeoutSeconds": 30,
    "IdleChunkTimeoutSeconds": 120,
    "MaxUploadDurationMinutes": 60
  },
  "ClientUpdates": {
    "Clients": {}
  }
}

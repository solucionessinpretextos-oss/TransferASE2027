<!--
  DOCUMENTACIÓN DE MANTENIMIENTO — TRANSFER ASE
  Archivo: TransferClienteASE/Vistas/VentanaPrincipal.xaml
  Capa: Cliente TransferClienteASE (WPF .NET)
  Propósito: Vista XAML WPF: define layout, controles, bindings y recursos visuales de una pantalla.
  Interacción: Se enlaza al ViewModel mediante Binding; muestra estado y dispara comandos sin conocer SQL ni backend.
  Regla de mantenimiento: Usar Mode=OneWay para propiedades calculadas de solo lectura; validar nombres de propiedades enlazadas.
  Notas específicas:
  - Propiedades calculadas o solo lectura deben enlazarse con Mode=OneWay para evitar InvalidOperationException de WPF.
  Esta documentación está pensada para orientar mantenimiento futuro sin tener que reconstruir el flujo desde cero.
-->
<Window x:Class="TransferClienteASE.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TransferClienteASE.Conversores"
        Title="ASE | Sistema de Transferencia de Archivos - Subida de archivos"
        Height="515"
        Width="1325"
        MinHeight="515"
        MinWidth="1010"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        Icon="/Recursos/filetransfer.ico">
    <!--
        DOCUMENTACIÓN INTERNA — VentanaPrincipal
        Esta vista muestra el detalle del contexto seleccionado y permite agregar archivos.
        El campo Apartado/Rubro usa Binding Mode=OneWay porque Contexto.ApartadoRubroDescripcion
        es una propiedad calculada de solo lectura. Si se quita Mode=OneWay y el control es TextBox,
        WPF intentará escribir de vuelta y lanzará InvalidOperationException.
    -->

    <Window.Resources>
        <conv:TruncatePercentageConverter x:Key="TruncatePercentageConverter"/>
<SolidColorBrush x:Key="UploadBackgroundBrush" Color="#533313"/>
        <SolidColorBrush x:Key="UploadPanelBackgroundBrush" Color="#DDC9A3"/>
        <SolidColorBrush x:Key="UploadHeaderStripBrush" Color="#754C24"/>
        <SolidColorBrush x:Key="UploadLabelBrush" Color="#533313"/>
<SolidColorBrush x:Key="UploadPrimaryButtonBrush" Color="#7B9963"/>
<SolidColorBrush x:Key="UploadSecondaryButtonBrush" Color="#754C24"/>
<SolidColorBrush x:Key="UploadFolderButtonBrush" Color="#D2B48C"/>
<SolidColorBrush x:Key="UploadExitButtonBrush" Color="#EEEEEE"/>
<SolidColorBrush x:Key="UploadExitButtonTextBrush" Color="#666666"/>

<SolidColorBrush x:Key="ListadoGridHeaderBrush" Color="#754C24"/>

        <Style x:Key="ListadoDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ListadoGridHeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ListadoDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ScrollViewer.Background" Value="#FFFFFF"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ListadoDataGridColumnHeaderStyle}"/>
        </Style>

        <Style x:Key="ListadoDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EDF7"/>
                    <Setter Property="Foreground" Value="#FF111111"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFE6EDF7"/>
                    <Setter Property="Foreground" Value="#FF111111"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListadoDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EDF7"/>
                    <Setter Property="Foreground" Value="#FF111111"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFE6EDF7"/>
                    <Setter Property="Foreground" Value="#FF111111"/>
                </Trigger>
            </Style.Triggers>
        </Style>
<Style x:Key="ContextLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource UploadLabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ContextValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AseTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
<Grid DockPanel.Dock="Top"
              Height="128"
              Background="{StaticResource AseHeaderBackground}">

            <TextBlock Text="{Binding TituloSubida}"
                       Foreground="#FFFFFF"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="16,0,0,10"/>
<Border VerticalAlignment="Top"
                    Height="7"
                    Background="#ffffff"
                    Margin="0,104,0,0"/>
            <Border VerticalAlignment="Top"
                    Height="16"
                    Background="#ddc9a3"
                    Margin="0,112,0,0"/>
        </Grid>
<Grid DockPanel.Dock="Bottom"
              Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding MensajeEstado}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="#777777"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
<Button Margin="4,0,0,0"
                        Command="{Binding ComandoAgregarArchivos}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AseFlatButton}">
                            <Setter Property="Background" Value="{StaticResource UploadSecondaryButtonBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinWidth" Value="170"/>
                            <Setter Property="Height" Value="38"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubidaEnProgreso}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/TransferClienteASE;component/Recursos/AGREGARDOCUMENTOS/documento.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Grid.Column="1"
                                       Text="Agregar documentos"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Button.Content>
                </Button>
<Button Margin="4,0,0,0"
                        Command="{Binding ComandoAgregarCarpetas}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AseFlatButton}">
                            <Setter Property="Background" Value="{StaticResource UploadFolderButtonBrush}"/>
<Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinWidth" Value="170"/>
                            <Setter Property="Height" Value="38"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubidaEnProgreso}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/TransferClienteASE;component/Recursos/AGREGARDOCUMENTOS/anexar%20carpetang.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Grid.Column="1"
                                       Text="Agregar carpetas"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Button.Content>
                </Button>
<Button Style="{StaticResource AseFlatButton}"
                        Margin="8,0,0,0"
                        Background="{StaticResource UploadPrimaryButtonBrush}"
                        Foreground="White"
                        MinWidth="210"
                        Height="38"
                        Click="BotonConfirmarSubir_Click">
                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/TransferClienteASE;component/Recursos/AGREGARDOCUMENTOS/aceptar.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Grid.Column="1"
                                       Text="Confirmar agregar archivos"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Button.Content>
                </Button>
<Button Style="{StaticResource AseFlatButton}"
                        Margin="8,0,0,0"
                        Background="{StaticResource UploadExitButtonBrush}"
                        Foreground="{StaticResource UploadExitButtonTextBrush}"
                        MinWidth="110"
                        Height="38"
                        Click="BotonSalir_Click">
                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/TransferClienteASE;component/Recursos/LISTADOREQUERIMIENTOS/cerrar-sesion.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>

                            <TextBlock Grid.Column="1"
                                       Text="Cerrar"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Grid>
<Border Margin="12"
                Background="#FFFFFF"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1">
            <Grid Margin="12" Background="#FFFFFF">
                <Grid.RowDefinitions>
<RowDefinition Height="21"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="82"/>
<RowDefinition Height="*"/>
                </Grid.RowDefinitions>
<Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
<TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Apartado/Rubro"
                               Style="{StaticResource ContextLabelStyle}"/>
<TextBox Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource ContextValueTextBoxStyle}"
                             Text="{Binding Contexto.ApartadoRubroDescripcion, Mode=OneWay, TargetNullValue='', FallbackValue=''}"/>
<TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{Binding EtiquetaElementoSeleccionado}"
                               Style="{StaticResource ContextLabelStyle}"/>

                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource ContextValueTextBoxStyle}"
                             Text="{Binding Contexto.Requerimiento.Descripcion, TargetNullValue='', FallbackValue=''}"/>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,8,0,8"
                        Padding="10,6"
                        Background="#FFF8F1"
                        BorderBrush="#DDC9A3"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Avance total"
                                           FontWeight="SemiBold"
                                           Foreground="#533313"/>
                                <TextBlock Text="{Binding ProgresoTotal, StringFormat={}{0:N0}%}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="#533313"/>
                            </DockPanel>
                            <ProgressBar Grid.Row="1"
                                         Height="18"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgresoTotal}"
                                         Foreground="#7B9963"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{Binding ArchivoActual}"
                                           FontWeight="SemiBold"
                                           Foreground="#533313"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProgresoArchivoActual, StringFormat={}{0:N0}%}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Margin="12,0,0,0"
                                           FontWeight="Bold"
                                           Foreground="#533313"/>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <ProgressBar Height="18"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgresoArchivoActual}"
                                             Foreground="#754C24"/>
                                <TextBlock Text="{Binding EtapaActual}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#222222"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

<DataGrid Grid.Row="3"
                          ItemsSource="{Binding Archivos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          Margin="0,0,0,0"
                          FontSize="14"
                          HorizontalGridLinesBrush="#FFDDDDDD"
                          VerticalGridLinesBrush="#FFDDDDDD"
                          Style="{StaticResource ListadoDataGridStyle}"
                          CellStyle="{StaticResource ListadoDataGridCellStyle}"
                          RowStyle="{StaticResource ListadoDataGridRowStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Archivo"
                                            Binding="{Binding NombreArchivo}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Ubicación original"
                                            Binding="{Binding UbicacionOriginal}"
                                            Width="3*"/>
                        <DataGridTextColumn Header="Tamaño"
                                            Binding="{Binding TamanioDescripcion}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="Progreso" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="18"
                                                     Value="{Binding Progreso}"
                                                     Foreground="#7B9963"/>
                                        <TextBlock Text="{Binding Progreso, StringFormat={}{0:N0}%}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Estado"
                                            Binding="{Binding Estado}"
                                            Width="105"/>
                        <DataGridTextColumn Header="Acción actual"
                                            Binding="{Binding AccionActual}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </DockPanel>
</Window>

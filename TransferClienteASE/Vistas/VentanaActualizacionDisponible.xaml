<!--
  DOCUMENTACIÓN DE MANTENIMIENTO — TRANSFER ASE
  Archivo: TransferClienteASE/Vistas/VentanaActualizacionDisponible.xaml
  Capa: Cliente TransferClienteASE (WPF .NET)
  Propósito: Vista XAML WPF: define layout, controles, bindings y recursos visuales de una pantalla.
  Interacción: Se enlaza al ViewModel mediante Binding; muestra estado y dispara comandos sin conocer SQL ni backend.
  Regla de mantenimiento: Usar Mode=OneWay para propiedades calculadas de solo lectura; validar nombres de propiedades enlazadas.
  Esta documentación está pensada para orientar mantenimiento futuro sin tener que reconstruir el flujo desde cero.
-->
<Window x:Class="TransferClienteASE.Vistas.VentanaActualizacionDisponible"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva versión disponible"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="480"
        MinHeight="260">
    <Border Margin="12"
            Padding="12"
            Background="{StaticResource AsePanelBackground}"
            BorderBrush="#FFCCCCCC"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Vertical"
                        Margin="0,0,0,8">
                <TextBlock x:Name="txtTitulo"
                           Text="Se encontró una nueva versión de Transfer ASE"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="txtVersiones"
                           FontSize="12"
                           Foreground="Gray"/>
            </StackPanel>

            <TextBox Grid.Row="1"
                     x:Name="txtNotas"
                     Margin="0,0,0,8"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="btnOmitir"
                        Content="Más tarde"
                        Margin="4"
                        Padding="12,4"
                        Click="btnOmitir_Click"/>
                <Button x:Name="btnActualizar"
                        Content="Actualizar ahora"
                        Margin="4"
                        Padding="12,4"
                        Background="#FF2E7D32"
                        Foreground="White"
                        Click="btnActualizar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

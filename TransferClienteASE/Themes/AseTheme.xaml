<!--
  DOCUMENTACIÓN DE MANTENIMIENTO — TRANSFER ASE
  Archivo: TransferClienteASE/Themes/AseTheme.xaml
  Capa: Cliente TransferClienteASE (WPF .NET)
  Propósito: Tema visual WPF: concentra estilos, colores y recursos de presentación reutilizables.
  Interacción: Las vistas consumen estos estilos para mantener identidad visual ASE consistente.
  Regla de mantenimiento: Cambios visuales globales afectan todas las pantallas; probar resoluciones y contraste.
  Esta documentación está pensada para orientar mantenimiento futuro sin tener que reconstruir el flujo desde cero.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="AseHeaderBackground" Color="#533313"/>
<SolidColorBrush x:Key="AseHeaderStrip"     Color="#FFB77E1D"/>
<SolidColorBrush x:Key="AsePageBackground"  Color="#FF2F2F2F"/>
<SolidColorBrush x:Key="AsePanelBackground" Color="#FFF5F5F5"/>
<SolidColorBrush x:Key="AseTextPrimary"     Color="#FF000000"/>
    <SolidColorBrush x:Key="AseTextSecondary"   Color="#FF666666"/>
    <SolidColorBrush x:Key="AseAccent"          Color="#FFB77E1D"/>
<SolidColorBrush x:Key="AseButtonBackground" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="AseButtonBorder"    Color="#FFB0B0B0"/>
<Style TargetType="TextBlock" x:Key="AseLabelText">
        <Setter Property="Foreground" Value="{StaticResource AseTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4,8,4"/>
    </Style>
<Style TargetType="TextBox" x:Key="AseTextBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="BorderBrush" Value="#FFB0B0B0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <Style TargetType="PasswordBox" x:Key="AsePasswordBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="BorderBrush" Value="#FFB0B0B0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>

<Style TargetType="Button" x:Key="AseFlatButton">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Background" Value="{StaticResource AseButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AseButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource AseTextPrimary}"/>
    </Style>
<Style TargetType="Button" x:Key="AseIconButton">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="6,4,0,4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource AseButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource AseTextPrimary}"/>
    </Style>

</ResourceDictionary>
